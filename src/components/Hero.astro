---
import { SITE, BIO, PROJECTS_LABEL, PROJECTS } from '../consts';

// Split the title on the dot so we can accent the "." like a logo.
const [before, ...rest] = SITE.title.split('.');
const after = rest.join('.');
---

<section class="hero" id="top">
  <div class="container">
    <h1 class="display">
      {before}<span class="dot">.</span>{after}
    </h1>

    <p class="bio">
      {BIO.map((line) => <span class="bio-line">{line}</span>)}
    </p>

    <h2 class="projects-label">{PROJECTS_LABEL}</h2>

    <ul class="projects">
      {
        PROJECTS.map((p) => (
          <li class="project">
            <span class="marker" aria-hidden="true">&gt;</span>
            {p.href ? (
              <a class="name" href={p.href}>{p.name}</a>
            ) : (
              <span class="name">{p.name}</span>
            )}
            <div class="meta">
              {p.description && <p class="desc">{p.description}</p>}
              {p.tech && <p class="tech">{p.tech}</p>}
              {p.links && (
                <p class="links">
                  {p.links.map((l) => (
                    <a href={l.href}>{l.label}</a>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2rem, 8vw, 5rem);
    padding-bottom: clamp(3rem, 9vw, 6rem);
  }

  .display {
    font-family: var(--font-display);
    font-weight: 400;
    /* 13vw keeps all 14 monospace characters on a single line from small
       phones up to where the column hits its max width (then the 6.5rem cap
       takes over). Verified to leave margin at every width via CDP. */
    font-size: clamp(2.25rem, 13vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: 0;
    white-space: nowrap;
    margin-bottom: clamp(0.75rem, 2.5vw, 1.25rem);
    /* subtle CRT-style glow, kept faint so it reads in both themes */
    text-shadow: 0 0 22px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .dot {
    color: var(--accent);
  }

  .bio {
    color: var(--text-muted);
    font-size: clamp(1.2rem, 3.2vw, 1.6rem);
    line-height: 1.35;
    margin-bottom: clamp(1.75rem, 5vw, 3rem);
  }

  /* Each fact gets its own line — the breaks are authored in consts.ts,
     not left to wrapping. */
  .bio-line {
    display: block;
  }

  .projects-label {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1rem, 2.8vw, 1.35rem);
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  .projects {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    line-height: 1.2;
  }

  /* Mobile: marker | name, with the meta lines underneath the name.
     Wide: marker | name | meta as three tidy columns. */
  .project {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 0.6rem;
  }

  .marker {
    grid-column: 1;
    grid-row: 1;
  }

  .name {
    grid-column: 2;
    grid-row: 1;
  }

  .meta {
    grid-column: 2;
    grid-row: 2;
    font-size: 0.55em;
    line-height: 1.3;
    margin-top: 0.15rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.2rem;
  }

  .marker {
    color: var(--accent);
  }

  .project a {
    color: var(--text);
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .project a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .desc {
    color: var(--text-muted);
  }

  .tech {
    color: var(--text-faint);
  }

  @media (min-width: 640px) {
    .project {
      grid-template-columns: auto 11ch 1fr;
      column-gap: 1rem;
    }
    .meta {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
    }
  }

  /* Tighten the hero on mobile so the carousels below get more of the screen. */
  @media (max-width: 1080px) {
    .hero {
      padding-top: 1rem;
      padding-bottom: 1.5rem;
    }
  }
</style>
